   "source": [
    "# Создаем маски для классов\n",
    "ac_anemia = (
    "    (data['rbc_ql'] < 0) &\n",
    "    (data['hgb_ql'] < 0) &\n",
    "    (data['mcv_ql'] == 0) &\n",
    "    (data['mchc_ql'] == 0) &\n",
    "    (data['soe_ql'] == 0) &\n",
    "    # (data['htc_ql'] < 0) &\n",
    "    (data['wbc_ql'] == 0) &\n",
    "    (data['ne_abs_ql'] == 0) &\n",
    "    (data['ba_abs_ql'] == 0) &\n",
    "    (data['eo_abs_ql'] == 0) &\n",
    "    (data['ly_abs_ql'] == 0) &\n",
    "    (data['plt_ql'] >= 0)\n",
    ")\n",
    "\n",
    "chr_anemia = (
    "    (data['rbc_ql'] < 0) &\n",
    "    (data['hgb_ql'] < 0) &\n",
    "    (data['mcv_ql'] < 0) &\n",
    "    (data['mchc_ql'] < 0) &\n",
    "    (data['soe_ql'] == 0) &\n",
    "    # (data['htc_ql'] < 0) &\n",
    "    (data['wbc_ql'] == 0) &\n",
    "    (data['ne_abs_ql'] == 0) &\n",
    "    (data['ba_abs_ql'] == 0) &\n",
    "    (data['eo_abs_ql'] == 0) &\n",
    "    (data['ly_abs_ql'] == 0) &\n",
    "    (data['plt_ql'] >= 0)\n",
    ")\n",
    "\n",
    "ac_infalm = (
    "    (data['rbc_ql'] == 0) &\n",
    "    (data['hgb_ql'] == 0) &\n",
    "    (data['mcv_ql'] == 0) &\n",
    "    (data['mchc_ql'] == 0) &\n",
    "    (data['soe_ql'] > 0) &\n",
    "    # (data['htc_ql'] == 0) &\n",
    "    (data['wbc_ql'] > 0) &\n",
    "    (data['ne_abs_ql'] > 0) &\n",
    "    (data['ba_abs_ql'] == 0) &\n",
    "    (data['eo_abs_ql'] == 0) &\n",
    "    (data['ly_abs_ql'] == 0) &\n",
    "    (data['plt_ql'] >= 0)\n",
    ")\n",
    "\n",
    "chr_infalm = (
    "    (data['rbc_ql'] == 0) &\n",
    "    (data['hgb_ql'] <= 0) &\n",
    "    (data['mcv_ql'] == 0) &\n",
    "    (data['mchc_ql'] == 0) &\n",
    "    (data['soe_ql'] > 0) &\n",
    "    # (data['htc_ql'] == 0) &\n",
    "    (data['wbc_ql'] == 0) &\n",
    "    (data['ne_abs_ql'] > 0) &\n",
    "    (data['ba_abs_ql'] == 0) &\n",
    "    (data['eo_abs_ql'] == 0) &\n",
    "    (data['ly_abs_ql'] == 0) &\n",
    "    (data['plt_ql'] >= 0)\n",
    ")\n",
    "\n",
    "spec_infalm = (
    "    (data['rbc_ql'] == 0) &",
    "    (data['hgb_ql'] < 0) &",
    "    (data['mcv_ql'] == 0) &",
    "    (data['mchc_ql'] == 0) &",
    "    (data['soe_ql'] > 0) &",
    "    # (data['htc_ql'] == 0) &",
    "    (data['wbc_ql'] == 0) &",
    "    (data['ne_abs_ql'] == 0) &",
    "    (data['ba_abs_ql'] == 0) &",
    "    (data['eo_abs_ql'] > 0) &",
    "    (data['ly_abs_ql'] > 0) &",
    "    (data['plt_ql'] > 0)",
    ")\n",
    "\n",
    "spec_infalm = (
    "    (data['rbc_ql'] == 0) &\n",
    "    (data['hgb_ql'] == 0) &\n",
    "    (data['mcv_ql'] == 0) &\n",
    "    (data['mchc_ql'] == 0) &\n",
    "    (data['soe_ql'] == 0) &\n",
    "    # (data['htc_ql'] == 0) &\n",
    "    (data['wbc_ql'] > 0) &\n",
    "    (data['ne_abs_ql'] == 0) &\n",
    "    (data['ba_abs_ql'] > 0) &\n",
    "    (data['eo_abs_ql'] > 0) &\n",
    "    (data['ly_abs_ql'] == 0) &\n",
    "    (data['plt_ql'] == 0)\n",
    ")\n",
    "\n",
    "spec_infalm = (\n",
    "    (data['rbc_ql'] < 0) &\n",
    "    (data['hgb_ql'] < 0) &\n",
    "    (data['mcv_ql'] < 0) &\n",
    "    (data['mchc_ql'] < 0) &\n",
    "    (data['soe_ql'] > 0) &\n",
    "    # (data['htc_ql'] < 0) &\n",
    "    (data['wbc_ql'] < 0) &\n",
    "    (data['ne_abs_ql'] < 0) &\n",
    "    (data['ba_abs_ql'] < 0) &\n",
    "    (data['eo_abs_ql'] < 0) &\n",
    "    (data['ly_abs_ql'] < 0) &\n",
    "    (data['plt_ql'] < 0)\n",
    ")"
   ]
